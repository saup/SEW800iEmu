 static void *coreaudio_audio_init(Audiodev *dev, Error **errp)
 {
+    AudiodevCoreaudioPerDirectionOptions *out = dev->u.coreaudio.out;
+    AudiodevCoreaudioPerDirectionOptions *in = dev->u.coreaudio.in;
+
+    if (out->has_debug_stop_grace && out->debug_stop_grace > 1000000) {
+        error_setg(errp, "CoreAudio out.debug-stop-grace must be at most "
+                   "1000000 microseconds");
+        return NULL;
+    }
+    if (in->has_debug_stop_grace && in->debug_stop_grace) {
+        error_setg(errp, "CoreAudio debug-stop-grace is playback-only");
+        return NULL;
+    }
     return dev;
 }
 
