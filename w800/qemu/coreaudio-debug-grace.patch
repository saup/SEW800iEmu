+/* CoreAudio PCM layout helpers: also exercised by the focused host test. */
+static void coreaudio_clear_buffers(AudioBufferList *buffers)
+{
+    for (UInt32 i = 0; i < buffers->mNumberBuffers; i++) {
+        AudioBuffer *buffer = &buffers->mBuffers[i];
+
+        if (buffer->mData && buffer->mDataByteSize) {
+            memset(buffer->mData, 0, buffer->mDataByteSize);
+        }
+    }
+}
+
+static size_t coreaudio_buffer_frames(const AudioBufferList *buffers,
+                                     unsigned channels, unsigned sample_bytes)
+{
+    unsigned remaining = channels;
+    size_t frames = SIZE_MAX;
+
+    if (!channels || !sample_bytes) {
+        return 0;
+    }
+    for (UInt32 i = 0; i < buffers->mNumberBuffers && remaining; i++) {
+        const AudioBuffer *buffer = &buffers->mBuffers[i];
+        size_t stride = (size_t)buffer->mNumberChannels * sample_bytes;
+
+        if (!stride) {
+            continue;
+        }
+        if (!buffer->mData) {
+            return 0;
+        }
+        size_t capacity = buffer->mDataByteSize / stride;
+        frames = frames < capacity ? frames : capacity;
+        remaining -= remaining < buffer->mNumberChannels ?
+                     remaining : buffer->mNumberChannels;
+    }
+    return remaining ? 0 : frames;
+}
+
+static void coreaudio_copy_frames(AudioBufferList *buffers, size_t output_frame,
+                                 const void *input, size_t frames,
+                                 unsigned channels, unsigned sample_bytes)
+{
+    const uint8_t *source = input;
+    size_t source_stride = (size_t)channels * sample_bytes;
+    unsigned source_channel = 0;
+
+    for (UInt32 i = 0; i < buffers->mNumberBuffers && source_channel < channels; i++) {
+        AudioBuffer *buffer = &buffers->mBuffers[i];
+        unsigned remaining = channels - source_channel;
+        unsigned copy_channels = remaining < buffer->mNumberChannels ?
+                                 remaining : buffer->mNumberChannels;
+        size_t stride = (size_t)buffer->mNumberChannels * sample_bytes;
+        uint8_t *destination = buffer->mData;
+
+        if (!copy_channels) {
+            continue;
+        }
+        destination += output_frame * stride;
+        if (source_channel == 0 && copy_channels == channels &&
+            buffer->mNumberChannels == channels) {
+            memcpy(destination, source, frames * source_stride);
+        } else {
+            for (size_t frame = 0; frame < frames; frame++) {
+                memcpy(destination + frame * stride,
+                       source + frame * source_stride + source_channel * sample_bytes,
+                       copy_channels * sample_bytes);
+            }
+        }
+        source_channel += copy_channels;
+    }
+}
+/* End CoreAudio PCM layout helpers. */
 
