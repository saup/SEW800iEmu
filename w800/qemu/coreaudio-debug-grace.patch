+/* Called with BQL, never while holding buf_mutex across a HAL call. */
+static void coreaudio_debug_report(coreaudioVoiceOut *core, const char *reason)
+{
+    uint64_t callbacks, frames, underruns, underrun_frames;
+    size_t pending;
+
+    if (!core->debug_diagnostics ||
+        coreaudio_buf_lock(core, "coreaudio_debug_report")) {
+        return;
+    }
+    callbacks = core->io_callbacks;
+    frames = core->io_frames;
+    underruns = core->io_underruns;
+    underrun_frames = core->io_underrun_frames;
+    pending = core->hw.pending_emul;
+    coreaudio_buf_unlock(core, "coreaudio_debug_report");
+    dolog("W800_COREAUDIO_DEBUG reason=%s realtime_ns=%" PRId64
+          " deferred=%" PRIu64
+          " cancelled=%" PRIu64 " expired=%" PRIu64
+          " hal_starts=%" PRIu64 " hal_stops=%" PRIu64
+          " callbacks=%" PRIu64 " delivered_frames=%" PRIu64
+          " underruns=%" PRIu64 " underrun_frames=%" PRIu64
+          " pending_bytes=%zu\n",
+          reason, qemu_clock_get_ns(QEMU_CLOCK_REALTIME),
+          core->debug_deferred, core->debug_cancelled,
+          core->debug_expired, core->hal_start_calls, core->hal_stop_calls,
+          callbacks, frames, underruns, underrun_frames, pending);
+}
+
+static void coreaudio_debug_stop(void *opaque)
+{
+    coreaudioVoiceOut *core = opaque;
+
+    /* REALTIME remains active while the guest is stopped at a breakpoint. */
+    if (!core->enabled) {
+        core->debug_expired++;
+        update_device_playback_state(core);
+        coreaudio_debug_report(core, "debug-timeout");
     }
 }
 
